#!/bin/sh
set -eu
APPDIR="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
export APPDIR
# Run host setup tools before adding bundled GUI libraries to the environment.
if [ "${1:-}" = --install ]; then
    unset LD_LIBRARY_PATH LD_PRELOAD
    exec /bin/bash "$APPDIR/usr/share/airpods-helper/install.sh"
fi
export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for hook in "$APPDIR"/apprun-hooks/*.sh; do
    [ ! -f "$hook" ] || . "$hook"
done
# Tauri's GTK deployment plugin relocates WebKit's /usr paths relative to here.
cd "$APPDIR/usr"
exec "$APPDIR/usr/bin/airpods-app" "$@"
